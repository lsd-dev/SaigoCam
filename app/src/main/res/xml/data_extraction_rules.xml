<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for API 31+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The stream password is device-specific; don't copy it to cloud backups -->
        <exclude domain="sharedpref" path="saigocam_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="saigocam_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
